# Copy to .env (proxy and api load it via dotenv)

# Infra (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate

# Service ports
PROXY_PORT=8080
API_PORT=4000

# Dashboard -> service URLs (server-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROXY_URL=http://localhost:8080

# Vaulted upstream provider keys (proxy forwards with these).
# Keyed by provider slug: <SLUG>_UPSTREAM_KEY. Add one per provider you enable.
OPENAI_UPSTREAM_KEY=sk-proxy-set-me
CLAUDE_UPSTREAM_KEY=sk-ant-proxy-set-me

# Auth (Better Auth runs on the api; the api is the auth authority).
# Generate a strong secret and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=generate-a-strong-secret
# Where Better Auth is served from (the api's own origin).
BETTER_AUTH_URL=http://localhost:4000
# The dashboard origin allowed through CORS (credentials) + trusted for CSRF.
DASHBOARD_ORIGIN=http://localhost:3000
# Production only: set when the dashboard and api live on different
# subdomains of the same root domain (e.g. app.tollgate.com / api.tollgate.com),
# to ".tollgate.com" (leading dot) so the session cookie is shared across both.
# Leave unset on localhost.
AUTH_COOKIE_DOMAIN=
