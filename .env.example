# Copy to .env (proxy and api load it via dotenv)

# Infra (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate

# Service ports
PROXY_PORT=8080
API_PORT=4000

# Dashboard -> service URLs (server-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROXY_URL=http://localhost:8080

# Vaulted upstream provider keys (proxy forwards with these).
# Keyed by provider slug: <SLUG>_UPSTREAM_KEY. Add one per provider you enable.
OPENAI_UPSTREAM_KEY=sk-proxy-set-me
CLAUDE_UPSTREAM_KEY=sk-ant-proxy-set-me
