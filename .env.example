# Copy to .env (proxy and api load it via dotenv)

# Infra (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate

# Service ports
PROXY_PORT=8080
API_PORT=4000

# Dashboard -> service URLs (server-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROXY_URL=http://localhost:8080

# Vaulted upstream provider keys (proxy forwards with these).
# Keyed by provider slug: <SLUG>_UPSTREAM_KEY. Add one per provider you enable.
# These are the DEPLOYMENT-WIDE FALLBACK, used only for orgs that haven't
# brought their own key (BYOK, below). Usage on these bills to Tollgate.
OPENAI_UPSTREAM_KEY=sk-proxy-set-me
CLAUDE_UPSTREAM_KEY=sk-ant-proxy-set-me
GEMINI_UPSTREAM_KEY=proxy-set-me
# Azure OpenAI and AWS Bedrock have NO env fallback: they need more than a
# single key (a per-customer resource name / an access-key pair plus region),
# which this <SLUG>_UPSTREAM_KEY convention can't express. Agents on those
# providers must be pointed at a stored key from the dashboard's Settings →
# Provider keys instead; otherwise the proxy returns upstream_key_unavailable.

# BYOK: encrypts orgs' own upstream provider keys at rest (org_upstream_keys).
# Must be IDENTICAL on the api (which encrypts) and the proxy (which decrypts) —
# a mismatch makes stored keys undecryptable, and the proxy then DENIES those
# orgs' requests rather than quietly falling back to the shared keys above.
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave unset to run without BYOK (every org uses the shared keys above).
VAULT_ENCRYPTION_KEY=

# Auth (Better Auth runs on the api; the api is the auth authority).
# Generate a strong secret and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=generate-a-strong-secret
# Where Better Auth is served from (the api's own origin).
BETTER_AUTH_URL=http://localhost:4000
# The dashboard origin allowed through CORS (credentials) + trusted for CSRF.
DASHBOARD_ORIGIN=http://localhost:3000
# Production only: set when the dashboard and api live on different
# subdomains of the same root domain (e.g. app.tollgate.com / api.tollgate.com),
# to ".tollgate.com" (leading dot) so the session cookie is shared across both.
# Leave unset on localhost.
AUTH_COOKIE_DOMAIN=

# How long spend_events.prompt (the request text behind the activity log's
# drill-in — see that column's doc comment in backend/api/src/db/schema.ts)
# is kept before a maintenance job nulls it out. The ROW stays (cost,
# decision, tokens) — only the request text has a shelf life. Not enforced
# automatically: run on your own schedule, e.g. a daily cron entry —
#   0 3 * * * cd /path/to/tollgate/backend/api && pnpm db:purge-old-prompts
# — or by hand. Defaults to 90 if unset or not a positive integer.
PROMPT_RETENTION_DAYS=90

# Hosted assistant behind the PUBLIC marketing site's install wizard
# (frontend/dashboard/app/(marketing)/get-started) — unauthenticated, so it's
# only ever asked generic pre-install questions, never customer agent data.
# Deliberately NOT the local Ollama model above: a public marketing page can't
# reach a visitor's local Ollama (it refuses cross-origin browser requests by
# design), and nothing is installed yet for a pre-install visitor anyway.
# OPTIONAL — leave unset and the page's Ask box simply doesn't render; the
# step-by-step instructions still do. Only the company's own public
# deployment of this codebase needs this set; a self-hoster's own instance
# has no reason to.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Local model behind the dashboard's agent-draft wizard (api only).
# OPTIONAL and off by default: start it with
#   docker compose --profile local-llm up -d
#   docker compose exec ollama ollama pull llama3.2
# A deployment that skips this keeps working — the api's availability probe
# answers false and the dashboard hides the wizard rather than offering a
# button that fails. Deliberately a LOCAL model: the descriptions it reads are
# the customer's own, and sending them to a provider would defeat the point of
# self-hosting. Set OLLAMA_URL to http://ollama:11434 when the api runs inside
# compose rather than on the host.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Polygres (pgContext) — a separate retrieval database FOR YOUR AGENTS, not for
# Tollgate itself. Start it with:
#   docker compose --profile polygres up -d
#   docker compose exec pgcontext psql -U polygres -d polygres -c "CREATE EXTENSION pgcontext;"
# Point your agent's own code at this connection string — Tollgate never reads
# or writes here. Not consumed by the api or proxy processes; documented here
# only so the connection info lives in one place with everything else.
POLYGRES_URL=postgres://polygres:polygres@localhost:5433/polygres

# SELF-HOSTING ONLY — leave unset for local dev and for the hosted
# deployment, neither of which check this. backend/api's and
# backend/proxy's Docker images (docker-compose.selfhost.yml) refuse to
# start without a valid one (backend/api/docker-entrypoint.sh,
# backend/proxy/docker-entrypoint.sh) — there is no self-serve way to get
# one; request it and Tollgate will send back a key minted with
# scripts/generate-license-key.mjs. See SELF_HOSTING.md's "Licensing".
TOLLGATE_LICENSE_KEY=

# SELF-HOSTING ONLY — OAuth2 / OIDC single sign-on.
#
# Lets your employees sign in with your own identity provider instead of a
# Tollgate-specific password. Built and validated against Red Hat SSO
# (Keycloak), and works unchanged with any OIDC-compliant IdP (Okta, Entra,
# Auth0) since it uses standard discovery.
#
# ONLY ACTIVE ON SELF-HOSTED DEPLOYMENTS. The api enables it only when
# TOLLGATE_LICENSE_KEY above is also set, so Tollgate's hosted service never
# federates to a customer IdP even if these are present. Leave all of these
# blank to keep SSO off — email+password stays enabled either way, and is
# deliberately never disabled, so you can still reach your dashboard when the
# IdP is unreachable. See backend/api/src/lib/sso.ts.
#
# BEFORE THIS WORKS, register this exact redirect URI in your IdP client:
#   <BETTER_AUTH_URL>/api/auth/oauth2/callback/sso
# e.g. https://api.tollgate.acme.com/api/auth/oauth2/callback/sso
# The client must allow the authorization-code flow with PKCE.
#
# Issuer INCLUDES the realm for Keycloak/Red Hat SSO. Discovery is fetched
# from <issuer>/.well-known/openid-configuration, so no other endpoint URLs
# are needed.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Optional — the sign-in button reads "Continue with <this>". Defaults to "SSO".
SSO_LABEL=
