# Copy to .env (proxy and api load it via dotenv)

# Infra (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate

# Service ports
PROXY_PORT=8080
API_PORT=4000

# Dashboard -> service URLs (server-side fetches)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROXY_URL=http://localhost:8080

# Vaulted upstream provider keys (proxy forwards with these).
# Keyed by provider slug: <SLUG>_UPSTREAM_KEY. Add one per provider you enable.
# These are the DEPLOYMENT-WIDE FALLBACK, used only for orgs that haven't
# brought their own key (BYOK, below). Usage on these bills to Tollgate.
OPENAI_UPSTREAM_KEY=sk-proxy-set-me
CLAUDE_UPSTREAM_KEY=sk-ant-proxy-set-me
GEMINI_UPSTREAM_KEY=proxy-set-me
# Azure OpenAI and AWS Bedrock have NO env fallback: they need more than a
# single key (a per-customer resource name / an access-key pair plus region),
# which this <SLUG>_UPSTREAM_KEY convention can't express. Agents on those
# providers must be pointed at a stored key from the dashboard's Settings →
# Provider keys instead; otherwise the proxy returns upstream_key_unavailable.

# BYOK: encrypts orgs' own upstream provider keys at rest (org_upstream_keys).
# Must be IDENTICAL on the api (which encrypts) and the proxy (which decrypts) —
# a mismatch makes stored keys undecryptable, and the proxy then DENIES those
# orgs' requests rather than quietly falling back to the shared keys above.
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave unset to run without BYOK (every org uses the shared keys above).
VAULT_ENCRYPTION_KEY=

# Auth (Better Auth runs on the api; the api is the auth authority).
# Generate a strong secret and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=generate-a-strong-secret
# Where Better Auth is served from (the api's own origin).
BETTER_AUTH_URL=http://localhost:4000
# The dashboard origin allowed through CORS (credentials) + trusted for CSRF.
DASHBOARD_ORIGIN=http://localhost:3000
# Production only: set when the dashboard and api live on different
# subdomains of the same root domain (e.g. app.tollgate.com / api.tollgate.com),
# to ".tollgate.com" (leading dot) so the session cookie is shared across both.
# Leave unset on localhost.
AUTH_COOKIE_DOMAIN=

# SELF-HOSTING ONLY — leave unset for local dev and for the hosted
# deployment, neither of which check this. backend/api's and
# backend/proxy's Docker images (docker-compose.selfhost.yml) refuse to
# start without a valid one (backend/api/docker-entrypoint.sh,
# backend/proxy/docker-entrypoint.sh) — there is no self-serve way to get
# one; request it and Tollgate will send back a key minted with
# scripts/generate-license-key.mjs. See SELF_HOSTING.md's "Licensing".
TOLLGATE_LICENSE_KEY=
