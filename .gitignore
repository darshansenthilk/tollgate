node_modules/
dist/
.next/
# .env* catches the real file plus anything derived from it — e.g. the
# timestamped backups scripts/setup-selfhost.sh makes before overwriting an
# existing .env, which contain the same real secrets and aren't safe to
# commit either. .env.example is the one file that SHOULD be tracked, so
# it's explicitly un-ignored below.
.env*
!.env.example
*.log
.DS_Store
*.tsbuildinfo
demo/.demo-agent.json

# Agent skills (installed globally, not vendored into the repo)
.agents/
.claude/skills/
skills-lock.json

#Claude documentation for intermediate thinking and context handling
claude-docs/

