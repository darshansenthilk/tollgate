{
  "name": "@tollgate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/run-migrate.ts",
    "db:auth-migrate": "tsx src/db/run-auth-migrate.ts",
    "db:wipe-agents": "tsx src/db/wipe-agents.ts",
    "db:purge-old-prompts": "tsx src/db/purge-old-prompts.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@tollgate/shared": "workspace:*",
    "better-auth": "^1.6.25",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
